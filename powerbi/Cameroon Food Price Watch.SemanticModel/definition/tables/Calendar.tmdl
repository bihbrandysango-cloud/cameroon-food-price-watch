table Calendar
	dataCategory: Time

	column Date
		dataType: dateTime
		isKey
		formatString: Short Date
		summarizeBy: none
		sourceColumn: [Date]

	column 'Month Start' = DATE ( YEAR ( [Date] ), MONTH ( [Date] ), 1 )
		dataType: dateTime
		formatString: mmm yyyy
		summarizeBy: none

	column Month = FORMAT ( [Date], "mmm yyyy" )
		dataType: string
		summarizeBy: none
		sortByColumn: 'Month Start'

	column Year = YEAR ( [Date] )
		dataType: int64
		formatString: 0
		summarizeBy: none

	partition Calendar = calculated
		mode: import
		source = CALENDAR ( DATE ( 2017, 1, 1 ), DATE ( 2026, 12, 31 ) )
