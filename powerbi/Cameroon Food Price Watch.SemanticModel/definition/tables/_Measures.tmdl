table _Measures

	measure 'Latest Month' = CALCULATE ( MAX ( Prices[price_month] ), REMOVEFILTERS ( Markets ) )
		formatString: mmmm yyyy

	measure 'Food Label' = SELECTEDVALUE ( Commodities[commodity], "the selected foods" )

	measure 'Month Label' = "Prices for " & FORMAT ( [Latest Month], "MMMM yyyy" )

	measure 'Markets Reporting' = ```
			VAR m = [Latest Month]
			RETURN CALCULATE ( DISTINCTCOUNT ( Prices[market_code] ), Prices[price_month] = m )
			```
		formatString: #,0

	measure 'Markets Judged' = ```
			VAR m = [Latest Month]
			RETURN CALCULATE ( DISTINCTCOUNT ( Prices[market_code] ), Prices[price_month] = m, Prices[direction] <> "Not enough history" )
			```
		formatString: #,0

	measure 'Markets Too Cheap' = ```
			VAR m = [Latest Month]
			RETURN COALESCE ( CALCULATE ( DISTINCTCOUNT ( Prices[market_code] ), Prices[price_month] = m, Prices[direction] = "Too cheap" ), 0 )
			```
		formatString: #,0

	measure 'Markets Too Expensive' = ```
			VAR m = [Latest Month]
			RETURN COALESCE ( CALCULATE ( DISTINCTCOUNT ( Prices[market_code] ), Prices[price_month] = m, Prices[direction] = "Too expensive" ), 0 )
			```
		formatString: #,0

	measure 'Headline Fraction' = ```
			VAR c = [Markets Too Cheap]
			VAR e = [Markets Too Expensive]
			RETURN FORMAT ( MAX ( c, e ), "0" ) & " / " & FORMAT ( [Markets Judged], "0" )
			```

	measure 'Headline Text' = ```
			VAR c = [Markets Too Cheap]
			VAR e = [Markets Too Expensive]
			VAR food = LOWER ( [Food Label] )
			RETURN
			    IF ( c >= e,
			        "markets selling " & food & " well below normal. " & e & " above.",
			        "markets where " & food & " costs well above normal. " & c & " below." )
			```

	measure 'Reporting Text' = [Markets Reporting] & " markets reported prices in " & FORMAT ( [Latest Month], "MMMM yyyy" ) & ". Markets need three years of history to be judged."

	measure 'Spotlight Market' = ```
			VAR m = [Latest Month]
			VAR t = ADDCOLUMNS ( VALUES ( Markets[market] ), "@gap", CALCULATE ( MAX ( Prices[gap_from_normal] ), Prices[price_month] = m ) )
			VAR best = TOPN ( 1, FILTER ( t, NOT ISBLANK ( [@gap] ) ), ABS ( [@gap] ), DESC )
			RETURN MAXX ( best, Markets[market] )
			```

	measure 'Spotlight Title' = ```
			VAR mk = [Spotlight Market]
			RETURN mk & " · " & CALCULATE ( MAX ( Markets[region] ), Markets[market] = mk )
			```

	measure 'FCFA per kg now' = ```
			VAR m = [Latest Month]
			VAR mk = [Spotlight Market]
			RETURN CALCULATE ( MAX ( Prices[price_per_unit] ), Prices[price_month] = m, Markets[market] = mk )
			```
		formatString: #,0

	measure 'Usual for this month' = ```
			VAR m = [Latest Month]
			VAR mk = [Spotlight Market]
			RETURN CALCULATE ( MAX ( Prices[normal_price] ), Prices[price_month] = m, Markets[market] = mk )
			```
		formatString: #,0

	measure 'Spotlight Gap' = ```
			VAR m = [Latest Month]
			VAR mk = [Spotlight Market]
			RETURN CALCULATE ( MAX ( Prices[gap_from_normal] ), Prices[price_month] = m, Markets[market] = mk )
			```
		formatString: +0%;-0%;0%

	measure 'Spotlight Note' = ```
			IF ( [Spotlight Gap] < 0,
			    "Cheap for buyers, hard on farmers.",
			    "Dear for buyers, good for sellers." )
			```

	measure 'Market Price' = ```
			VAR m = [Latest Month]
			RETURN CALCULATE ( MAX ( Prices[price_per_unit] ), Prices[price_month] = m )
			```
		formatString: #,0

	measure 'Market Normal' = ```
			VAR m = [Latest Month]
			RETURN CALCULATE ( MAX ( Prices[normal_price] ), Prices[price_month] = m )
			```
		formatString: #,0

	measure 'Market Alert Order' = ```
			VAR m = [Latest Month]
			RETURN CALCULATE ( MIN ( Prices[alert_order] ), Prices[price_month] = m )
			```
		formatString: 0

	measure 'Gap From Normal' = ```
			VAR m = [Latest Month]
			VAR o = [Market Alert Order]
			RETURN IF ( o < 6, CALCULATE ( MAX ( Prices[gap_from_normal] ), Prices[price_month] = m ) )
			```
		formatString: +0%;-0%;0%

	measure 'Market Status' = SWITCH ( [Market Alert Order], 1, "Alert: too expensive", 2, "Watch: rising", 3, "Normal", 4, "Watch: falling", 5, "Alert: too cheap", 6, "Not enough history" )

	measure 'Market Colour' = SWITCH ( [Market Alert Order], 1, "#C8372D", 2, "#C8372D", 3, "#8F8A7E", 4, "#2864A8", 5, "#2864A8", "#C9C6BB" )

	measure 'Map Longitude' = IF ( NOT ISBLANK ( [Market Price] ), MAX ( Markets[lon] ) )
		formatString: 0.00

	measure 'Map Latitude' = IF ( NOT ISBLANK ( [Market Price] ), MAX ( Markets[lat] ) )
		formatString: 0.00

	measure 'Map Dot Size' = SWITCH ( [Market Alert Order], 1, 4, 5, 4, 2, 2, 4, 2, 3, 1.4, 1 )
		formatString: 0.0

	measure 'Page Title' = [Food Label] & " prices this month"

	measure 'Page Subtitle' = SELECTEDVALUE ( PriceType[Price type], "All" ) & " prices · " & FORMAT ( [Latest Month], "MMMM yyyy" ) & " · compared with the same month in the last five years"

	measure 'Cheap Fraction' = [Markets Too Cheap] & " of " & [Markets Judged]

	measure 'Biggest Change Label' = "biggest: " & [Spotlight Market]

	measure 'Spotlight Gap Colour' = IF ( [Spotlight Gap] < 0, "#2864A8", "#C8372D" )

	measure 'Watch Rank' = ```
			VAR g = [Gap From Normal]
			RETURN
			    IF ( NOT ISBLANK ( g ),
			        RANKX ( FILTER ( ALLSELECTED ( Markets[market] ), NOT ISBLANK ( [Gap From Normal] ) ), ABS ( [Gap From Normal] ), ABS ( g ), DESC ) )
			```
		formatString: 0

	measure Now = ```
			VAR r = [Watch Rank]
			RETURN IF ( NOT ISBLANK ( r ) && r <= 7, [Market Price] )
			```
		formatString: #,0

	measure Usual = ```
			VAR r = [Watch Rank]
			RETURN IF ( NOT ISBLANK ( r ) && r <= 7, [Market Normal] )
			```
		formatString: #,0

	measure Change = ```
			VAR r = [Watch Rank]
			RETURN IF ( NOT ISBLANK ( r ) && r <= 7, [Gap From Normal] )
			```
		formatString: +0%;-0%;0%

	measure 'Alert Type' = ```
			VAR m = [Latest Month]
			VAR t = CALCULATETABLE ( VALUES ( AlertTypes[alert_type] ), AlertTypes[price_month] = m )
			RETURN IF ( COUNTROWS ( t ) = 1, MAXX ( t, AlertTypes[alert_type] ), IF ( COUNTROWS ( t ) > 1, "mixed" ) )
			```

	measure Why = ```
			VAR r = [Watch Rank]
			RETURN IF ( NOT ISBLANK ( r ) && r <= 7,
			    SWITCH ( [Alert Type], "market-wide shift", "Many markets", "general price shift", "All foods",
			        "local, lasting", "Local, lasting", "local, new", "Local, new", "mixed", "Mixed" ) )
			```

	measure 'Price Type Label' = SELECTEDVALUE ( PriceType[Price type], "All" )

	measure 'Cheaper Markets' = ```
			VAR m = [Latest Month]
			RETURN CALCULATE ( DISTINCTCOUNT ( Prices[market_code] ), Prices[price_month] = m, Prices[direction] = "Too cheap" )
			```
		formatString: #,0

	measure 'Normal Markets' = ```
			VAR m = [Latest Month]
			RETURN CALCULATE ( DISTINCTCOUNT ( Prices[market_code] ), Prices[price_month] = m, Prices[direction] = "Normal" )
			```
		formatString: #,0

	measure 'Dearer Markets' = ```
			VAR m = [Latest Month]
			RETURN CALCULATE ( DISTINCTCOUNT ( Prices[market_code] ), Prices[price_month] = m, Prices[direction] = "Too expensive" )
			```
		formatString: #,0

	measure 'Market Colour Light' = ```
			VAR g = [Gap From Normal]
			RETURN SWITCH ( TRUE (), ISBLANK ( g ), "#C9C6BB", g >= 0.2, "#C8372D", g <= -0.2, "#2864A8", "#8F8A7E" )
			```

	measure 'Selected Market' = SELECTEDVALUE ( Markets[market], "all markets" )

	measure 'Market Page Title' = [Selected Market] & " · " & [Food Label]

	measure 'Market Page Subtitle' = ```
			VAR r = SELECTEDVALUE ( Markets[region] )
			RETURN IF ( NOT ISBLANK ( r ), r & " region · ", "" ) & [Price Type Label] & " prices over time, FCFA per kg"
			```

	measure 'Market Last Month' = CALCULATE ( MAX ( Prices[price_month] ) )
		formatString: mmmm yyyy

	measure 'Latest Price' = ```
			VAR m = [Market Last Month]
			RETURN CALCULATE ( AVERAGE ( Prices[price_per_unit] ), Prices[price_month] = m )
			```
		formatString: #,0

	measure 'Latest Usual' = ```
			VAR m = [Market Last Month]
			RETURN CALCULATE ( AVERAGE ( Prices[normal_price] ), Prices[price_month] = m )
			```
		formatString: #,0

	measure 'Latest Change' = ```
			VAR m = [Market Last Month]
			RETURN CALCULATE ( AVERAGE ( Prices[gap_from_normal] ), Prices[price_month] = m )
			```
		formatString: +0%;-0%;0%

	measure 'Latest Change Colour' = ```
			VAR g = [Latest Change]
			RETURN SWITCH ( TRUE (), ISBLANK ( g ), "#C9C6BB", g >= 0.2, "#C8372D", g <= -0.2, "#2864A8", "#8F8A7E" )
			```

	measure 'Months With Prices' = DISTINCTCOUNT ( Prices[price_month] )
		formatString: #,0

	measure 'Monthly Price' = AVERAGE ( Prices[price_per_unit] )
		formatString: #,0

	measure 'Monthly Usual' = AVERAGE ( Prices[normal_price] )
		formatString: #,0

	measure 'Gap Last 12 Months' = ```
			VAR last = CALCULATE ( MAX ( Prices[price_month] ), ALLSELECTED ( Calendar ) )
			VAR d = MAX ( Calendar[Date] )
			RETURN IF ( d > EOMONTH ( last, -12 ) && d <= EOMONTH ( last, 0 ), AVERAGE ( Prices[gap_from_normal] ) )
			```
		formatString: +0%;-0%;0%

	measure 'Gap 12 Colour' = ```
			VAR g = [Gap Last 12 Months]
			RETURN SWITCH ( TRUE (), ISBLANK ( g ), "#C9C6BB", g >= 0.2, "#C8372D", g <= -0.2, "#2864A8", "#8F8A7E" )
			```

	measure 'Market Facts 1' = ```
			IF ( ISBLANK ( SELECTEDVALUE ( Markets[market] ) ), "Choose one market to see its details.",
			    SELECTEDVALUE ( Markets[region] ) & " region, " & SELECTEDVALUE ( Markets[department] ) & " department" )
			```

	measure 'Market Facts 2' = ```
			IF ( NOT ISBLANK ( SELECTEDVALUE ( Markets[market] ) ),
			    "Prices from " & FORMAT ( SELECTEDVALUE ( Markets[first_month] ), "MMM yyyy" ) & " to " & FORMAT ( SELECTEDVALUE ( Markets[last_month] ), "MMM yyyy" ) )
			```

	measure 'Market Facts 3' = ```
			IF ( NOT ISBLANK ( SELECTEDVALUE ( Markets[market] ) ),
			    SELECTEDVALUE ( Markets[months_with_prices] ) & " months with a price, " & FORMAT ( SELECTEDVALUE ( Markets[coverage] ), "0%" ) & " of that time" )
			```

	measure 'Market Facts 4' = ```
			IF ( NOT ISBLANK ( SELECTEDVALUE ( Markets[market] ) ),
			    IF ( SELECTEDVALUE ( Markets[is_reporting_now] ), "Still reporting", "Has stopped reporting" ) )
			```

	measure 'Report Month' = CALCULATE ( MAX ( Prices[price_month] ), REMOVEFILTERS ( Markets ), REMOVEFILTERS ( Commodities ) )
		formatString: mmmm yyyy

	measure 'Food Typical Gap' = ```
			VAR m = [Report Month]
			RETURN CALCULATE ( MEDIAN ( Prices[gap_from_normal] ), Prices[price_month] = m )
			```
		formatString: +0%;-0%;0%

	measure 'Food Gap Colour' = ```
			VAR g = [Food Typical Gap]
			RETURN SWITCH ( TRUE (), ISBLANK ( g ), "#C9C6BB", g >= 0.2, "#C8372D", g <= -0.2, "#2864A8", "#8F8A7E" )
			```

	measure 'Food Typical Price' = ```
			VAR m = [Report Month]
			RETURN CALCULATE ( MEDIAN ( Prices[price_per_unit] ), Prices[price_month] = m )
			```
		formatString: #,0

	measure 'Food Usual' = ```
			VAR m = [Report Month]
			RETURN CALCULATE ( MEDIAN ( Prices[normal_price] ), Prices[price_month] = m )
			```
		formatString: #,0

	measure 'Food Unit' = ```
			VAR m = [Report Month]
			RETURN CALCULATE ( MAX ( Prices[standard_unit] ), Prices[price_month] = m )
			```

	measure 'Food Cheaper' = ```
			VAR m = [Report Month]
			RETURN CALCULATE ( DISTINCTCOUNT ( Prices[market_code] ), Prices[price_month] = m, Prices[direction] = "Too cheap" )
			```
		formatString: #,0

	measure 'Food Normal' = ```
			VAR m = [Report Month]
			RETURN CALCULATE ( DISTINCTCOUNT ( Prices[market_code] ), Prices[price_month] = m, Prices[direction] = "Normal" )
			```
		formatString: #,0

	measure 'Food Dearer' = ```
			VAR m = [Report Month]
			RETURN CALCULATE ( DISTINCTCOUNT ( Prices[market_code] ), Prices[price_month] = m, Prices[direction] = "Too expensive" )
			```
		formatString: #,0

	measure 'Foods Mostly Cheaper' = COALESCE ( COUNTROWS ( FILTER ( VALUES ( Commodities[commodity] ), [Food Typical Gap] <= -0.2 ) ), 0 )
		formatString: #,0

	measure 'Foods Mostly Dearer' = COALESCE ( COUNTROWS ( FILTER ( VALUES ( Commodities[commodity] ), [Food Typical Gap] >= 0.2 ) ), 0 )
		formatString: #,0

	measure 'Foods Judged' = COALESCE ( COUNTROWS ( FILTER ( VALUES ( Commodities[commodity] ), NOT ISBLANK ( [Food Typical Gap] ) ) ), 0 )
		formatString: #,0

	measure 'Biggest Food Mover' = ```
			VAR t = FILTER ( ADDCOLUMNS ( VALUES ( Commodities[commodity] ), "@g", [Food Typical Gap] ), NOT ISBLANK ( [@g] ) )
			RETURN MAXX ( TOPN ( 1, t, ABS ( [@g] ), DESC ), Commodities[commodity] )
			```

	measure 'Biggest Food Gap' = ```
			VAR f = [Biggest Food Mover]
			RETURN CALCULATE ( [Food Typical Gap], Commodities[commodity] = f )
			```
		formatString: +0%;-0%;0%

	measure 'Biggest Food Colour' = ```
			VAR g = [Biggest Food Gap]
			RETURN SWITCH ( TRUE (), ISBLANK ( g ), "#C9C6BB", g >= 0.2, "#C8372D", g <= -0.2, "#2864A8", "#8F8A7E" )
			```

	measure 'Biggest Food Label' = "biggest: " & [Biggest Food Mover]

	measure 'Foods Subtitle' = [Price Type Label] & " prices · " & FORMAT ( [Report Month], "MMMM yyyy" ) & " · each food against the same month in the last five years"

	measure 'Region Typical Gap' = ```
			VAR m = [Latest Month]
			RETURN CALCULATE ( MEDIAN ( Prices[gap_from_normal] ), Prices[price_month] = m )
			```
		formatString: +0%;-0%;0%

	measure 'Region Gap Colour' = ```
			VAR g = [Region Typical Gap]
			RETURN SWITCH ( TRUE (), ISBLANK ( g ), "#C9C6BB", g >= 0.2, "#C8372D", g <= -0.2, "#2864A8", "#8F8A7E" )
			```

	measure 'Regions Reporting' = COALESCE ( COUNTROWS ( FILTER ( VALUES ( Markets[region] ), NOT ISBLANK ( [Market Price] ) ) ), 0 )
		formatString: #,0

	measure 'Lowest Region' = ```
			VAR t = FILTER ( ADDCOLUMNS ( VALUES ( Markets[region] ), "@g", [Region Typical Gap] ), NOT ISBLANK ( [@g] ) )
			RETURN MAXX ( TOPN ( 1, t, [@g], ASC ), Markets[region] )
			```

	measure 'Highest Region' = ```
			VAR t = FILTER ( ADDCOLUMNS ( VALUES ( Markets[region] ), "@g", [Region Typical Gap] ), NOT ISBLANK ( [@g] ) )
			RETURN MAXX ( TOPN ( 1, t, [@g], DESC ), Markets[region] )
			```

	measure 'Lowest Region Gap' = ```
			VAR r = [Lowest Region]
			RETURN CALCULATE ( [Region Typical Gap], Markets[region] = r )
			```
		formatString: +0%;-0%;0%

	measure 'Highest Region Gap' = ```
			VAR r = [Highest Region]
			RETURN CALCULATE ( [Region Typical Gap], Markets[region] = r )
			```
		formatString: +0%;-0%;0%

	measure 'Lowest Region Colour' = ```
			VAR g = [Lowest Region Gap]
			RETURN SWITCH ( TRUE (), ISBLANK ( g ), "#C9C6BB", g >= 0.2, "#C8372D", g <= -0.2, "#2864A8", "#8F8A7E" )
			```

	measure 'Highest Region Colour' = ```
			VAR g = [Highest Region Gap]
			RETURN SWITCH ( TRUE (), ISBLANK ( g ), "#C9C6BB", g >= 0.2, "#C8372D", g <= -0.2, "#2864A8", "#8F8A7E" )
			```

	measure 'Lowest Region Label' = "lowest: " & [Lowest Region]

	measure 'Highest Region Label' = "highest: " & [Highest Region]

	measure 'Regions Title' = [Food Label] & " prices by region"

	measure 'Regions Subtitle' = [Price Type Label] & " prices · " & FORMAT ( [Latest Month], "MMMM yyyy" ) & " · against the same month in the last five years"

	measure 'Forecast Month Label' = FORMAT ( MAX ( Forecast[forecast_month] ), "MMM yyyy" )

	measure 'Expected Cheaper' = COALESCE ( CALCULATE ( DISTINCTCOUNT ( Forecast[market_code] ), Forecast[forecast_direction] = "Too cheap" ), 0 )
		formatString: #,0

	measure 'Expected Dearer' = COALESCE ( CALCULATE ( DISTINCTCOUNT ( Forecast[market_code] ), Forecast[forecast_direction] = "Too expensive" ), 0 )
		formatString: #,0

	measure 'Range Start' = MAX ( Forecast[forecast_low] )
		formatString: #,0

	measure 'Range Width' = MAX ( Forecast[forecast_high] ) - MAX ( Forecast[forecast_low] )
		formatString: #,0

	measure 'Forecast Price' = MAX ( Forecast[forecast_price] )
		formatString: #,0

	measure 'Forecast Usual' = MAX ( Forecast[normal_price] )
		formatString: #,0

	measure 'Last Price' = MAX ( Forecast[last_price] )
		formatString: #,0

	measure 'Likely Range' = IF ( NOT ISBLANK ( [Range Start] ), FORMAT ( MAX ( Forecast[forecast_low] ), "#,0" ) & " to " & FORMAT ( MAX ( Forecast[forecast_high] ), "#,0" ) )

	measure Expected = ```
			VAR l = MAX ( Forecast[forecast_alert_level] )
			RETURN SWITCH ( l, "alert high", "Much dearer", "watch high", "Dearer", "normal", "Normal",
			    "watch low", "Cheaper", "alert low", "Much cheaper", "not enough history", "Not judged" )
			```

	measure 'Expected Colour' = SWITCH ( MAX ( Forecast[forecast_direction] ), "Too cheap", "#2864A8", "Too expensive", "#C8372D", "Normal", "#8F8A7E", "#C9C6BB" )

	measure 'Forecast Title' = [Food Label] & ": what next month may bring"

	measure 'Forecast Subtitle' = "Forecast for " & [Forecast Month Label] & " · " & [Price Type Label] & " prices · FCFA per kg"

	measure 'Suspect Prices' = COUNTROWS ( Suspect )
		formatString: #,0

	measure 'Reporting Fraction' = CALCULATE ( COUNTROWS ( Markets ), Markets[is_reporting_now] = TRUE () ) & " of " & COUNTROWS ( Markets )

	measure 'Average Coverage' = AVERAGE ( Markets[coverage] )
		formatString: 0%

	measure 'Price Records' = COUNTROWS ( Prices )
		formatString: #,0

	measure 'Records Latest Year' = ```
			VAR y = YEAR ( MAX ( Prices[price_month] ) )
			RETURN CALCULATE ( COUNTROWS ( Prices ), FILTER ( ALL ( Prices[price_month] ), YEAR ( Prices[price_month] ) = y ) )
			```
		formatString: #,0

	measure 'Direction Score' = 0.5506
		formatString: 0%

	partition _Measures = calculated
		mode: import
		source = ROW("x",0)
